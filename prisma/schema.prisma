generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Platform {
  TIKTOK
  INSTAGRAM
  OTHER
}

enum FunnelStage {
  TOFU
  MOFU
  BOFU
}

model Client {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  whatsapp  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scripts Script[]

  @@index([name])
}

model CompetitorVideo {
  id           String   @id @default(cuid())
  platform     Platform @default(OTHER)
  url          String?
  title        String
  authorHandle String?
  niche        String
  painPoints   String // comma-separated tags
  transcript   String
  thumbnailUrl String?
  notes        String?
  metrics      String? // freeform JSON string (likes, views, comments...)
  createdAt    DateTime @default(now())

  scripts Script[]

  @@index([niche])
  @@index([createdAt])
}

model Script {
  id          String      @id @default(cuid())
  funnelStage FunnelStage
  angle       String
  hook        String
  development String
  cta         String
  fullText    String
  favorite    Boolean     @default(false)
  variantNo   Int         @default(1)
  model       String      @default("template-engine")

  competitorVideo   CompetitorVideo? @relation(fields: [competitorVideoId], references: [id], onDelete: SetNull)
  competitorVideoId String?

  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  createdAt DateTime @default(now())

  @@index([funnelStage])
  @@index([favorite])
}
